# Notion Integration (Agency HQ -> Leads & Sales Pipeline)
# 1. Create an Internal Integration at: https://www.notion.so/my-integrations
# 2. Grant access to your "Leads & Sales Pipeline" database.
# 3. Copy the 'Internal Integration Secret' and database ID below.
NOTION_API_KEY=ntn_your_notion_integration_secret_here
NOTION_DATABASE_ID=bb8c1b3c-c0b9-47e7-a727-26c84e8b95b4

# Email Provider Configuration (e.g. Resend, SendGrid)
# Obtain an API key from https://resend.com
EMAIL_PROVIDER_API_KEY=re_your_email_provider_api_key_here

# Lead Notification Recipient
NOTIFICATION_EMAIL=Adityak1149x@gmail.com

# Optional CRM Webhook URL (Slack, Discord, Zapier, Airtable)
CONTACT_WEBHOOK_URL=
