# ==============================================================================
# DataCraft Studio — Production CRM & Notification Environment Configuration
# Copy this file to .env.local for local development. Never commit .env.local or secrets to Git!
# ==============================================================================

# Notion CRM Integration
# Target Destination: Agency HQ → Leads & Sales Pipeline
# 1. Create an Internal Integration at: https://www.notion.so/my-integrations
# 2. Open the "Leads & Sales Pipeline" database in Notion -> Click "..." -> Connections -> Add your integration.
# 3. Paste the Integration Secret (starts with secret_ or ntn_) below:
NOTION_API_KEY=
NOTION_DATABASE_ID=d3908f13-dcd3-43f2-bf0c-76b9232df686
NOTION_DATA_SOURCE_ID=bb8c1b3c-c0b9-47e7-a727-26c84e8b95b4

# Web3Forms Email Integration (https://web3forms.com)
# Obtain your free access key by entering your email at https://web3forms.com
WEB3FORMS_ACCESS_KEY=your_access_key

# Lead Notification Recipient (Studio Founders)
NOTIFICATION_EMAIL=Adityak1149x@gmail.com

# Durable Serverless Fallback Queue (Upstash Redis / Vercel KV)
# Prevents enquiry loss on serverless cold starts or network outages
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV alternative:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Remote Backup Webhook (Slack, Discord, Zapier, Make, n8n)
LEAD_BACKUP_WEBHOOK_URL=
